static NSString *ORUnitID(NSDictionary *unit){return AMPreflightHash([NSJSONSerialization dataWithJSONObject:unit options:NSJSONWritingSortedKeys error:NULL]);}
static NSDictionary *ORRootUnit(NSDictionary *context){NSMutableArray *docs=NSMutableArray.array;for(NSDictionary *doc in context[@"documents"]){NSMutableDictionary *copy=doc.mutableCopy;copy[@"startLine"]=@1;copy[@"endLine"]=@([[doc[@"text"] componentsSeparatedByString:@"\n"] count]);[docs addObject:copy];}return @{@"documents":docs,@"images":context[@"images"] ?: @[]};}
