- (void)addCoursesFromFolder:(id)sender {
    NSOpenPanel *panel=NSOpenPanel.openPanel;panel.canChooseFiles=NO;panel.canChooseDirectories=YES;panel.message=@"选择课程仓库或包含多个课程的父目录";if([panel runModal]!=NSModalResponseOK)return;NSString *root=panel.URL.path;NSArray *existing=[self.courses copy];
    [self work:@"匹配已有课程目录" forCourse:nil operation:^id(NSError **error){NSArray *forks=[self.github accessibleForks:error];if(!forks)return nil;NSMutableArray *configs=NSMutableArray.array;for(NSDictionary *fork in forks){NSMutableDictionary *old=nil;for(NSDictionary *saved in existing)if([saved[@"fork"] isEqual:fork[@"full_name"]])old=saved.mutableCopy;NSMutableDictionary *config=old ?: NSMutableDictionary.dictionary;config[@"fork"]=fork[@"full_name"];[configs addObject:config];}NSDictionary *matches=[self.git matchingDirectories:root courses:configs];NSMutableArray *rows=NSMutableArray.array;for(NSDictionary *input in configs){NSArray *paths=matches[input[@"fork"]];if(!paths.count)continue;NSMutableDictionary *config=input.mutableCopy;NSDictionary *details=[self.github repository:config[@"fork"] error:error],*parent=details[@"parent"];if(!parent[@"id"])return nil;[config addEntriesFromDictionary:@{@"forkID":details[@"id"],@"upstreamID":parent[@"id"],@"ownerID":details[@"owner"][@"id"],@"upstream":parent[@"full_name"],@"upstreamURL":parent[@"clone_url"] ?: @"",@"upstreamBranch":parent[@"default_branch"] ?: @"main",@"branch":config[@"branch"] ?: details[@"default_branch"] ?: @"main",@"enabled":config[@"enabled"] ?: @YES,@"timeZone":config[@"timeZone"] ?: NSTimeZone.localTimeZone.name}];BOOL linked=[config[@"path"] length]>0;[rows addObject:[@{@"fork":config[@"fork"],@"course":config,@"upstream":config[@"upstream"],@"matches":paths,@"path":linked ? config[@"path"]:(paths.count==1 ? paths.firstObject:@""),@"ready":@NO,@"status":linked ? @"保留已有目录；如需更换，请明确选择":(paths.count==1 ? @"已匹配，待确认身份":@"找到多个目录，请选择")} mutableCopy]];}return rows;
    } completion:^(NSArray *rows,NSError *error){if(!rows.count){[self showError:error ?: AMPeerError(@"没有找到与当前账户个人仓库对应的课程目录")];return;}self.setupRecords=rows.mutableCopy;self.setupStep=2;self.guided=YES;self.setupSelection=[rows valueForKey:@"fork"];[self presentCourseSetup];[self updateCourseSetup:@"核对目录后关联；不会自动下载或覆盖已有配置。"];}];
}
- (void)readCourseLocalState:(NSString *)identifier {
    NSDictionary *course=[[self savedCourse:@{@"fork":identifier}] copy];if(![course[@"path"] length])return;if(!self.courseLocalStates)self.courseLocalStates=NSMutableDictionary.dictionary;if(!self.courseStateReads)self.courseStateReads=NSMutableSet.set;if([self.courseStateReads containsObject:identifier])return;[self.courseStateReads addObject:identifier];
    [self work:@"读取本地状态" forCourse:course requestKey:@"course-local-status" priority:20 kind:AMCourseWorkLocal operation:^id(NSError **error){NSArray *changes=[self.git changesForCourse:course error:error];if(!changes)return nil;NSMutableArray *files=NSMutableArray.array;for(NSDictionary *file in changes)[files addObject:file[@"path"]];NSArray *records=AMSubmissionRecords(error);if(!records)return nil;NSString *push=@"";for(NSDictionary *record in records.reverseObjectEnumerator)if([record[@"repository"] isEqual:identifier] && [record[@"branch"] isEqual:course[@"branch"]]){NSString *state=record[@"state"];push=[state isEqual:@"confirmed"] ? ([record[@"kind"] isEqual:@"sync"] ? @"已核验同步":@"已核验推送"):([state isEqual:@"local"] ? @"提交已保存 · 待推送":@"推送待核验");break;}
        NSString *remote=AMSubmissionBaseline(course,NULL)[@"tip"];for(NSDictionary *record in records.reverseObjectEnumerator)if([record[@"repository"] isEqual:identifier] && [record[@"branch"] isEqual:course[@"branch"]] && AMPeerSHA(record[@"remoteCommit"])){remote=record[@"remoteCommit"];break;}
        NSDictionary *distance=[self.git localPushStateForCourse:course remoteCommit:remote error:error];if(!distance)return nil;
        NSString *pending=@"推送状态待核验";if([distance[@"known"] boolValue])pending=[NSString stringWithFormat:@"相比上次核验：待推送%@%@",distance[@"ahead"],[distance[@"behind"] integerValue]>0 ? [NSString stringWithFormat:@" · 远端新增%@",distance[@"behind"]]:@""];
        if(push.length)push=[pending stringByAppendingFormat:@" · 最近记录：%@",push];else push=pending;
        return @{@"summary":[NSString stringWithFormat:@"%@%@%@",changes.count ? [NSString stringWithFormat:@"%lu个文件有改动",(unsigned long)changes.count]:@"工作区无改动",push.length ? @" · ":@"",push],@"files":files};
    } completion:^(NSDictionary *state,NSError *error){[self.courseStateReads removeObject:identifier];NSDictionary *saved=[self savedCourse:course];if(![saved[@"path"] isEqual:course[@"path"]] || ![saved[@"branch"] isEqual:course[@"branch"]])return;self.courseLocalStates[identifier]=state ?: @{@"summary":error.localizedDescription ?: @"本地状态读取未完成",@"files":@[]};[self refreshPresentation];}];
}
