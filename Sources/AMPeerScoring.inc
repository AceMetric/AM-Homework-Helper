        if(![asset[@"image"] boolValue]){if(error && !*error)*error=AMPeerError(@"作业引用的图片缺失或不可读取，不能完整评分");return NO;}
        total+=[asset[@"data"] length];if(total>64*1024*1024 || materials.count>=256){if(error)*error=AMPeerError(@"图片材料超过本批预算，请缩小范围");return NO;}
        NSMutableDictionary *copy=asset.mutableCopy;copy[@"path"]=virtualPath;copy[@"role"]=entry[@"role"];copy[@"originRepository"]=repository;copy[@"originPath"]=path;
        [materials addObject:copy];known[virtualPath]=copy;
      }
    }
    return YES;
}
- (NSArray *)remoteSources:(NSArray *)materials {
