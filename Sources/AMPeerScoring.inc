    for(NSDictionary *entry in materials.copy){
      for(NSDictionary *reference in AMPreflightImageReferences(entry[@"text"] ?: @"")){
        NSString *virtualPath=AMPreflightResolveImage(entry[@"path"],reference[@"reference"]);
        if(known[virtualPath ?: @""]){if(![known[virtualPath][@"image"] boolValue]){if(error)*error=AMPeerError(@"图片引用未对应可读图片，请补充原图");return NO;}continue;}
