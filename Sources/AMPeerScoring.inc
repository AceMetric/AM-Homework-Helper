        if([row[@"sourceTimestamp"] length])[markdown appendFormat:@"来源时间：%@\n\n",row[@"sourceTimestamp"]];
        if(row[@"score"])[markdown appendFormat:@"**%@/%@**%@\n\n",row[@"score"],row[@"maximum"],row[@"model"] ? [@" · " stringByAppendingString:row[@"model"]]:@""];
        if(row[@"text"])[markdown appendFormat:@"%@\n\n",row[@"text"]];
        NSDictionary *definition=row[@"rubricDefinition"];if([definition[@"criteria"] count]){[markdown appendString:@"### 评分标准\n\n"];for(NSDictionary *criterion in definition[@"criteria"])[markdown appendFormat:@"- %@：%@分\n",criterion[@"title"],criterion[@"maximum"]];[markdown appendString:@"\n"];}
        for(NSDictionary *item in row[@"result"][@"items"]){NSString *title=item[@"id"];for(NSDictionary *criterion in definition[@"criteria"])if([criterion[@"id"] isEqual:item[@"id"]])title=criterion[@"title"];[markdown appendFormat:@"### %@ · %@分\n\n%@\n\n",title,item[@"score"],item[@"reason"]];for(NSDictionary *evidence in item[@"evidence"])[markdown appendFormat:@"`%@:%@`\n\n> %@\n\n",evidence[@"path"],evidence[@"line"] ?: @"图片区域",evidence[@"quote"]];}
    }
    AMDocumentView *view=AMDocumentView.new;view.renderedOnly=YES;view.markdown=markdown;[self.workspace setPreviewView:view];
}
